{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@arthome/tooling/tsconfig/app.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"],
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "next-env.d.ts", "next.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
