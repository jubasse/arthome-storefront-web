{
  "name": "arthome-storefront-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "prettier": "@arthome/tooling/prettier",
  "scripts": {
    "postinstall": "arthome-sync-agent-docs",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "use-core": "node tools/use-core.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/check.cache",
    "format:check:full": "prettier --check .",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives --cache --cache-strategy content --cache-location node_modules/.cache/eslint/main.cache",
    "lint:full": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "next typegen && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo",
    "typecheck:full": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:versions": "arthome-check-versions --repo arthome-storefront-web",
    "check:tsconfig": "arthome-check-tsconfig",
    "check:enums": "arthome-check-enums",
    "check:language": "arthome-check-language",
    "check:symbols": "arthome-check-symbols",
    "check:prettier-conflict": "arthome-check-prettier-conflict",
    "check:core-specs": "node tools/check-core-specs.mjs",
    "verify:offline": "pnpm run check:core-specs && pnpm run check:versions && pnpm run check:tsconfig && pnpm run check:enums && pnpm run check:language && pnpm run check:symbols",
    "verify": "pnpm run verify:offline && pnpm run check:prettier-conflict && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:full": "pnpm run verify:offline && pnpm run check:prettier-conflict && pnpm run format:check:full && pnpm run lint:full && pnpm run typecheck:full && pnpm run test"
  },
  "dependencies": {
    "@arthome/contracts": "https://github.com/jubasse/arthome-core/releases/download/v0.4.0-rc.3/arthome-contracts-0.4.0-rc.3.tgz",
    "@arthome/core": "https://github.com/jubasse/arthome-core/releases/download/v0.4.0-rc.3/arthome-core-0.4.0-rc.3.tgz",
    "hls.js": "1.7.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arthome/tooling": "https://github.com/jubasse/arthome-core/releases/download/v0.4.0-rc.3/arthome-tooling-0.4.0-rc.3.tgz",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.2",
    "vitest": "5.0.1"
  }
}
